{
  "name": "didrun",
  "version": "0.1.0",
  "description": "Did your scheduled GitHub workflows run when they should have? Late, missed, failed and green-but-empty runs, workflows GitHub disabled, and the 60-day inactivity countdown, from GitHub's own run history with your own token. No account, no code change; a CLI, a GitHub Action and a local MCP tool.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "didrun": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentwares/didrun.git"
  },
  "homepage": "https://agentwares-agentcheck.vercel.app/didrun",
  "bugs": {
    "url": "https://github.com/agentwares/didrun/issues"
  },
  "keywords": [
    "github-actions",
    "cron",
    "schedule",
    "scheduled-workflows",
    "cron-monitoring",
    "heartbeat",
    "dead-mans-switch",
    "missed-runs",
    "workflow-monitoring",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "pretest": "pnpm run build:dist",
    "pretypecheck": "pnpm run build:dist",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build:dist": "tsup"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
